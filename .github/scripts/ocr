#!/usr/bin/env bash
set -u

wrapper_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
real_ocr=
IFS=: read -r -a path_dirs <<< "${PATH:-}"
for path_dir in "${path_dirs[@]}"; do
    if [[ -n "$path_dir" && "$path_dir" != "$wrapper_dir" && -x "$path_dir/ocr" ]]; then
        real_ocr="$path_dir/ocr"
        break
    fi
done

if [[ -z "$real_ocr" ]]; then
    printf 'OpenCodeReview CLI is not on PATH.\n' >&2
    exit 127
fi

if [[ "${1:-}" == "review" ]]; then
    # Signal only the npm launcher: it forwards TERM to OCR; two signals force exit.
    timeout --foreground --signal=TERM --kill-after=60s 35m "$real_ocr" "$@"
else
    "$real_ocr" "$@"
fi
ocr_exit_code=$?
if [[ "${1:-}" != "review" ]]; then
    exit "$ocr_exit_code"
fi

result_path=/tmp/ocr-result.json
if [[ ! -s "$result_path" ]] || ! command -v jq >/dev/null 2>&1; then
    printf 'Could not verify OpenCodeReview review status.\n' >&2
    if (( ocr_exit_code != 0 )); then
        exit "$ocr_exit_code"
    fi
    exit 1
fi

review_status="$(jq -er '.status | strings' "$result_path")" || {
    printf 'OpenCodeReview result has no valid review status.\n' >&2
    if (( ocr_exit_code != 0 )); then
        exit "$ocr_exit_code"
    fi
    exit 1
}

finding_count="$(jq -er 'if (.comments | type) == "array" then (.comments | length) else error("comments must be an array") end' "$result_path")" || {
    printf 'OpenCodeReview result has no valid comments array.\n' >&2
    if (( ocr_exit_code != 0 )); then
        exit "$ocr_exit_code"
    fi
    exit 1
}

if (( ocr_exit_code == 124 )) || [[ "$review_status" == partial ]] ||
    jq -e '.summary.budget_exceeded == true' "$result_path" >/dev/null; then
    stop_reason="stopped with status $review_status"
    if (( ocr_exit_code == 124 )); then
        stop_reason="reached the 35-minute time limit"
    elif jq -e '.summary.budget_exceeded == true' "$result_path" >/dev/null; then
        stop_reason="reached the 20M token budget"
    fi
    printf -v message 'Review incomplete: %s; publishing %s confirmed finding(s).' \
        "$stop_reason" "$finding_count"
    updated_result="$(mktemp "${result_path}.XXXXXX")" || exit 1
    jq --arg message "$message" '
        if .status == "complete" or .status == "success" then
            .status = "partial"
        else . end |
        if .manifest.terminal_state? == "complete" then
            .manifest.terminal_state = "partial"
        else . end |
        .message = $message |
        .warnings = (.warnings // []) + [{type: "review_incomplete", message: $message}]
    ' "$result_path" > "$updated_result" && mv "$updated_result" "$result_path" || exit 1
    printf '%s\n' "$message" >&2
    exit 0
fi

if (( finding_count > 0 )); then
    if (( ocr_exit_code != 0 )) || [[ "$review_status" != complete && "$review_status" != success && "$review_status" != skipped ]]; then
        printf 'OpenCodeReview ended with status %s and exit %s; publishing %s finding(s).\n' "$review_status" "$ocr_exit_code" "$finding_count" >&2
    fi
    exit 0
fi

if (( ocr_exit_code != 0 )); then
    exit "$ocr_exit_code"
fi

if [[ "$review_status" != complete && "$review_status" != success && "$review_status" != skipped ]]; then
    printf 'OpenCodeReview ended with status %s; withholding PR comments.\n' "$review_status" >&2
    exit 1
fi
